# Copy to .env and fill in. Never commit .env. All names are case-insensitive.
# Secrets marked (secret) must only ever live server-side.

# ---------- app ----------
APP_ENV=dev                          # dev | test | prod
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000   # comma-separated frontend origins

# ---------- models ----------
# MODEL_PROVIDER: bedrock-openai | bedrock-converse | groq | ollama (ollama = dev only)
MODEL_PROVIDER=bedrock-openai
MODEL=openai.gpt-oss-120b
FALLBACK_MODELS=                     # comma-separated, same provider
JUDGE_PROVIDER=bedrock-openai        # LLM-as-judge for evals (narrative quality only)
JUDGE_MODEL=openai.gpt-oss-120b

AWS_REGION=ap-south-1
OPENAI_API_KEY=                     # (secret) Bedrock API key (OpenAI-compatible endpoint); prod should use an IAM role
OPENAI_BASE_URL=                    # https://bedrock-mantle.<region>.api.aws/v1
GROQ_API_KEY=                        # (secret) dev/CI smoke only (free tier is heavily rate-limited)
OLLAMA_BASE_URL=http://localhost:11434

# ---------- database (Neon) ----------
ANALYST_DATABASE_URL=                # (secret) POOLED string, role analyst_ro — the agent's only DB access
APP_DATABASE_URL=                    # (secret) DIRECT string, app role — threads, checkpoints
ADMIN_DATABASE_URL=                  # (secret) DIRECT string, app_admin — migrations/seed only, never the agent

# ---------- sandbox (E2B) ----------
E2B_API_KEY=                         # (secret)
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_TEMPLATE=code-interpreter-v1
SANDBOX_COMMAND_TIMEOUT_SECONDS=120

# ---------- observability (Langfuse) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=                 # (secret)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------- auth / access code ----------
DEMO_ACCESS_CODE=                    # (secret) code that unlocks live runs
SESSION_TOKEN_SECRET=                # (secret) e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_TOKEN_TTL_MINUTES=120

# ---------- limits & budgets ----------
MAX_AGENT_STEPS=40
SQL_MAX_ROWS=10000
SQL_STATEMENT_TIMEOUT_MS=15000
TOOL_PREVIEW_ROWS=5
MAX_TOOL_OUTPUT_CHARS=4000
MAX_TOKENS_PER_REQUEST=300000
MAX_COST_USD_PER_REQUEST=0.10
MAX_COST_USD_PER_SESSION=0.50
RATE_LIMIT_PER_MINUTE=10

# ---------- frontend (web/.env.local) — PUBLIC values only ----------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
