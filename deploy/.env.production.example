# Copy to deploy/.env ON THE SERVER and fill in. Never commit it. chmod 600 deploy/.env
# Comments only on their own lines: Docker Compose and the app parse inline comments differently.
#
# Not here on purpose: ADMIN_DATABASE_URL. The server never needs the database owner's password;
# migrations and seeding run from a developer machine.

# Public host name of the API, pointing at the server's Elastic IP. With no domain of your own,
# use a free DuckDNS name, e.g. sandbox-analyst.duckdns.org (Caddy gets a Let's Encrypt
# certificate for it). Not sslip.io: it shares one certificate rate limit across all its users.
API_HOST=

APP_ENV=prod
LOG_LEVEL=INFO
# The deployed frontend origin(s), comma-separated, e.g. https://sandbox-analyst.vercel.app
CORS_ALLOW_ORIGINS=

MODEL_PROVIDER=bedrock-openai
MODEL=openai.gpt-oss-120b
AWS_REGION=ap-south-1
# Bedrock API key and endpoint (OpenAI-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1

# Neon: pooled analyst_ro string (agent SQL) and direct app_rw string (threads, checkpoints).
ANALYST_DATABASE_URL=
APP_DATABASE_URL=

E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_TEMPLATE=code-interpreter-v1
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_IDLE_SECONDS=300

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Accounts: the Clerk production instance's Frontend API URL (Clerk dashboard -> API keys).
# Tokens are only accepted from CORS_ALLOW_ORIGINS unless CLERK_AUTHORIZED_PARTIES is set.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
# Access code each account enters once to run live questions.
DEMO_ACCESS_CODE=

# Limits and budgets (see SECURITY.md).
APPROVAL_MODE=normal

# ---------- users' own databases (ADR-030) ----------
# (secret) 32 random bytes, base64url. Encrypts saved database passwords. Unset = feature off.
# Generate: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep a copy somewhere safe: losing it makes every saved connection unusable.
CONNECTION_ENCRYPTION_KEY=
MAX_CONNECTIONS_PER_OWNER=5
CONNECTION_TESTS_PER_HOUR=20         # test/save/refresh attempts, per account and per IP
CONNECTION_TRASH_DAYS=7              # recycle bin; then the connection and its threads are purged
TRACE_USER_CONNECTIONS=false         # true: runs on users' databases are traced in Langfuse too
MAX_AGENT_STEPS=40
MAX_TOKENS_PER_REQUEST=300000
MAX_TOKENS_PER_OWNER_PER_DAY=2000000
MAX_TOKENS_PER_DAY=8000000
RATE_LIMIT_PER_MINUTE=10
RUNS_PER_IP_PER_HOUR=20
SESSIONS_PER_IP_PER_HOUR=10
LOGIN_ATTEMPTS_PER_MINUTE=5
MAX_CONCURRENT_RUNS=3
