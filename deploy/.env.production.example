# Copy to deploy/.env ON THE SERVER and fill in. Never commit it. chmod 600 deploy/.env
# Comments only on their own lines: Docker Compose and the app parse inline comments differently.
#
# Not here on purpose: ADMIN_DATABASE_URL. The server never needs the database owner's password;
# migrations and seeding run from a developer machine.

# Public host name of the API. With no domain, use the server's public IP via sslip.io,
# e.g. 13.233.1.2 -> 13-233-1-2.sslip.io (Caddy gets a Let's Encrypt certificate for it).
API_HOST=

APP_ENV=prod
LOG_LEVEL=INFO
# The deployed frontend origin(s), comma-separated, e.g. https://sandbox-analyst.vercel.app
CORS_ALLOW_ORIGINS=

MODEL_PROVIDER=bedrock-openai
MODEL=openai.gpt-oss-120b
AWS_REGION=ap-south-1
# Bedrock API key and endpoint (OpenAI-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1

# Neon: pooled analyst_ro string (agent SQL) and direct app_rw string (threads, checkpoints).
ANALYST_DATABASE_URL=
APP_DATABASE_URL=

E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_TEMPLATE=code-interpreter-v1
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_IDLE_SECONDS=300

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Access code for live questions, and the secret that signs session tokens
# (generate: python -c "import secrets; print(secrets.token_urlsafe(48))").
DEMO_ACCESS_CODE=
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_MINUTES=120

# Limits and budgets (see SECURITY.md).
APPROVAL_MODE=normal
MAX_AGENT_STEPS=40
MAX_TOKENS_PER_REQUEST=300000
MAX_TOKENS_PER_OWNER_PER_DAY=2000000
MAX_TOKENS_PER_DAY=8000000
RATE_LIMIT_PER_MINUTE=10
RUNS_PER_IP_PER_HOUR=20
SESSIONS_PER_IP_PER_HOUR=10
LOGIN_ATTEMPTS_PER_MINUTE=5
MAX_CONCURRENT_RUNS=3
